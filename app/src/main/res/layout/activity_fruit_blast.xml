<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121622"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:background="#1E2436">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 Sorting Balls"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/txtLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LEVEL 1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#80D8FF"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/txtScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOVES: 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFD54F"/>

    </LinearLayout>

    <!-- INSTRUCTION -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="Tap a tube to pick top ball, tap another to place"
        android:textSize="12sp"
        android:textColor="#90A4AE"
        android:layout_marginTop="4dp"/>

    <!-- GAME AREA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="#181E2E"
        android:padding="6dp">

        <com.example.minigamehub.FruitBlastView
            android:id="@+id/fruitView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </LinearLayout>

    <!-- CONTROLS CONTAINER (comfortably above bottom navigation area) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- NEXT LEVEL BUTTON -->
        <Button
            android:id="@+id/btnNextLevel"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="NEXT LEVEL 🌟"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00C853"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

        <!-- RESTART LEVEL BUTTON -->
        <Button
            android:id="@+id/btnRestart"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="RESTART LEVEL 🔄"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3F51B5"
            android:layout_marginBottom="6dp"/>

        <!-- BACK BUTTON -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="BACK TO GAMES 🎮"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#B0BEC5"
            android:backgroundTint="#263238"/>

    </LinearLayout>

</LinearLayout>
