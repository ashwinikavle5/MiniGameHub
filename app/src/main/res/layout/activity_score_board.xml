<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F3FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 Score Board"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#7B4BB7"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your best scores"
            android:textSize="16sp"
            android:textColor="#777777"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp"/>


        <!-- SNAKE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="🐍"
                android:textSize="38sp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Snake Game"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <TextView
                    android:id="@+id/txtSnakeScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Score: 0"
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- TIC TAC TOE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="❌⭕"
                android:textSize="30sp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tic Tac Toe"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <TextView
                    android:id="@+id/txtTicTacToeScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Score: 0"
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- SUBWAY RUNNER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="🏃"
                android:textSize="38sp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subway Runner"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <TextView
                    android:id="@+id/txtTileEscapeScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Score: 0"
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- BUBBLE SHOOTER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="🫧"
                android:textSize="38sp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bubble Shooter"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <TextView
                    android:id="@+id/txtBubbleShooterScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Score: 0"
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- FRUIT BLAST -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="🍉"
                android:textSize="38sp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fruit Blast"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"/>

                <TextView
                    android:id="@+id/txtFruitBlastScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Score: 0"
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- BACK BUTTON -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="BACK TO GAMES 🎮"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B4BB7"/>

    </LinearLayout>

</ScrollView>
